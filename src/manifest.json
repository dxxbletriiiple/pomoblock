{
	"manifest_version": 3,
	"default_locale": "en",
	"name": "__MSG_extensionName__",
	"version": "1.0.0",
	"description": "__MSG_extensionDescription__",
	"action": {
		"default_popup": "index.html",
		"default_title": "PomoBlock",
		"default_icon": {
			"16": "icons/tomato-16.png",
			"19": "icons/tomato-19.png",
			"32": "icons/tomato-32.png",
			"38": "icons/tomato-38.png"
		}
	},
	"icons": {
		"16": "icons/tomato-16.png",
		"32": "icons/tomato-32.png",
		"48": "icons/tomato-48.png",
		"128": "icons/tomato-128.png"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": [
		"storage",
		"tabs",
		"alarms",
		"declarativeNetRequest",
		"declarativeNetRequestWithHostAccess"
	],
	"host_permissions": ["<all_urls>"],
	"web_accessible_resources": [
		{
			"resources": ["blocked.html"],
			"matches": ["<all_urls>"]
		}
	]
}
